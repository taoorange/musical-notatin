{
  "name": "five-line-staff",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "npm run build:web",
    "build:web": "vue-tsc && vite build",
    "build:test": "vue-tsc && vite build --mode test",
    "build:ios": "vue-tsc && vite build && npx cap sync",
    "build:cap": "npm run build:ios",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "preview": "vite preview",
    "cypress:install": "npx cypress install",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "lint": "eslint src tests",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{vue,ts,js,cjs,mjs}": "eslint --max-warnings 0"
  },
  "dependencies": {
    "@capacitor/core": "8.3.1",
    "@capacitor/ios": "8.3.1",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "@panzoom/panzoom": "^4.6.2",
    "@taotao-lib/opensheetmusicdisplay": "^1.0.4",
    "ionicons": "^7.0.0",
    "js-synthesizer": "^1.13.0",
    "jszip": "^3.10.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "verovio": "^6.1.0",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.1",
    "@vitejs/plugin-legacy": "^5.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "husky": "^9.1.7",
    "jsdom": "^22.1.0",
    "lint-staged": "^17.0.7",
    "sass": "^1.99.0",
    "terser": "^5.4.0",
    "typescript": "~5.9.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^0.34.6",
    "vue-tsc": "^2.1.10"
  },
  "optionalDependencies": {
    "cypress": "^13.5.0"
  },
  "description": "An Ionic project"
}
